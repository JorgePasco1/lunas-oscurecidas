# --- Accounts ---
# One or more PNP accounts to watch/book for. Use ACCOUNT_i_* (i = 1..N).
# LABEL is a friendly name used in messages/state. EXPEDIENTE optional (empty =
# first row). Each account must already have reached the "Separar Cita" stage.
ACCOUNT_1_LABEL=Jorge
ACCOUNT_1_TIPO_DOC=DNI
ACCOUNT_1_DNI=70886597
ACCOUNT_1_CLAVE=your-password-here
ACCOUNT_1_EXPEDIENTE=34104

# ACCOUNT_2_LABEL=Amigo
# ACCOUNT_2_TIPO_DOC=DNI
# ACCOUNT_2_DNI=
# ACCOUNT_2_CLAVE=
# ACCOUNT_2_EXPEDIENTE=

# (Legacy single-account vars PNP_DNI / PNP_CLAVE / EXPEDIENTE still work if no
#  ACCOUNT_1_DNI is set.)

# --- Auto-booking ---
# Master switch. false = notify only (never books).
BOOKING_ENABLED=false
# true = do everything EXCEPT the final confirm (reports "would book"). Keep true
# until the confirm flow is validated on a real cupo, then set false to go live.
DRY_RUN_BOOKING=true
# Prefer the earliest slot that fits ALL unbooked accounts together (go together).
BOOK_SAME_SLOT=true
# Concurrent booking browser sessions (Pi RAM is limited; 1 = sequential).
BOOK_CONCURRENCY=1
# Opt-in: during a dry-run, click "Reservar Cita" to reveal the confirm screen,
# capture it, then click "Cancelar" to abort. Reveals the real confirm DOM.
# DRY_RUN_PROBE=false

# --- Warm sessions (fast booking) ---
# true = keep ONE always-on browser per account permanently logged in and parked
# at the reserva modal, polling every WARM_POLL_SECONDS and booking in-place
# (~2-3s) instead of building a cold session (~20s) each time. This is the way to
# actually catch fast-vanishing LIMA slots. Costs one Chromium per account
# (~350MB); a Pi 4 (>=2GB) handles two comfortably. Replaces the cron loop.
# Sessions self-heal: each poll checks it's still logged in and re-logins if not.
WARM_SESSIONS=false
# Seconds between availability polls per warm session (default 10).
WARM_POLL_SECONDS=10

# --- Slot preference (optional) ---
# Book ONLY this date, preferring PREFER_HORA, else the earliest other hour that
# day. Used to line an account up with a partner already booked on a set date.
# Empty = book the earliest available slot on any date.
# PREFER_FECHA=01/10/2026
# PREFER_HORA=08:00
# Hold-out deadline (Lima date YYYY-MM-DD). On/after this date the preference is
# dropped and the bot books the earliest slot on ANY date. Empty = hold forever.
# PREFER_UNTIL=2026-09-06

# --- What to watch ---
# Sede (location) to monitor. Must match the dropdown label exactly.
TARGET_SEDE=LIMA-LA VICTORIA

# --- Telegram ---
# Create a bot with @BotFather to get the token.
# Get your chat id: message the bot once, then open
#   https://api.telegram.org/bot<TOKEN>/getUpdates  and read result[].message.chat.id
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789

# --- Scheduling / behaviour ---
# Cron expression for the availability check (default: every 2 minutes).
# Slots can vanish within minutes; use */1 for max coverage, but keep it modest
# since the site does IP-based blocking and we don't want to look abusive.
CHECK_CRON=*/2 * * * *
# Send an "alive" heartbeat every N hours (default 6)
HEARTBEAT_HOURS=6
# Fire a "degraded" alert after this many consecutive failures (default 3)
FAILURE_ALERT_THRESHOLD=3
# Directory for persisted state + failure screenshots
DATA_DIR=./data

# Optional dead-man's-switch: a free https://healthchecks.io check URL.
# The watcher pings it every cycle; if pings stop (Pi/internet down),
# healthchecks.io emails/notifies you. Leave empty to disable.
HEALTHCHECK_URL=
# Run the browser headless (true in prod; set false locally for selector discovery)
HEADLESS=true
# Use a system Chromium instead of Playwright's downloaded build.
# On Raspberry Pi OS set this to the system binary (e.g. /usr/bin/chromium).
# Leave empty on the Mac to use Playwright's bundled Chromium.
CHROMIUM_PATH=
# Write failure screenshots (skipped for network errors regardless). Set false
# to fully disable on write-sensitive storage (old microSD).
SAVE_SCREENSHOTS=true
# Hard cap (MB) on the screenshots folder; oldest are pruned after each save.
SCREENSHOT_MAX_MB=100
