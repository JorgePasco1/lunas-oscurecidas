# --- PNP login credentials ---
# Tipo de documento: DNI (default) or CE
PNP_TIPO_DOC=DNI
PNP_DNI=70886597
PNP_CLAVE=your-password-here

# Optional: which expediente row to open if the account has several.
# Leave empty to use the first (or only) row.
EXPEDIENTE=34104

# --- What to watch ---
# Sede (location) to monitor. Must match the dropdown label exactly.
TARGET_SEDE=LIMA-LA VICTORIA

# --- Telegram ---
# Create a bot with @BotFather to get the token.
# Get your chat id: message the bot once, then open
#   https://api.telegram.org/bot<TOKEN>/getUpdates  and read result[].message.chat.id
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789

# --- Scheduling / behaviour ---
# Cron expression for the availability check (default: every 5 minutes)
CHECK_CRON=*/5 * * * *
# Send an "alive" heartbeat every N hours (default 6)
HEARTBEAT_HOURS=6
# Fire a "degraded" alert after this many consecutive failures (default 3)
FAILURE_ALERT_THRESHOLD=3
# Directory for persisted state + failure screenshots
DATA_DIR=./data

# Optional dead-man's-switch: a free https://healthchecks.io check URL.
# The watcher pings it every cycle; if pings stop (Pi/internet down),
# healthchecks.io emails/notifies you. Leave empty to disable.
HEALTHCHECK_URL=
# Run the browser headless (true in prod; set false locally for selector discovery)
HEADLESS=true
# Use a system Chromium instead of Playwright's downloaded build.
# On Raspberry Pi OS set this to the system binary (e.g. /usr/bin/chromium).
# Leave empty on the Mac to use Playwright's bundled Chromium.
CHROMIUM_PATH=
# Write failure screenshots (skipped for network errors regardless). Set false
# to fully disable on write-sensitive storage (old microSD).
SAVE_SCREENSHOTS=true
