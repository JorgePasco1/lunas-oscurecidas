[Unit]
Description=Lunas Oscurecidas cupo watcher
# Wait for the network before starting; keep retrying if it isn't up yet.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jorgepasco1
WorkingDirectory=/home/jorgepasco1/lunas-oscurecidas
# The app loads .env itself (via dotenv), so WorkingDirectory is what matters.
# Node from NodeSource lives at /usr/bin/node.
ExecStart=/usr/bin/node dist/index.js

# Resilience: restart on any exit (crash, unhandled error, OOM) and on reboot.
Restart=always
RestartSec=10
# If it crash-loops, back off instead of hammering the flaky link forever.
StartLimitIntervalSec=300
StartLimitBurst=20

# Logs go to the journal: view with `journalctl -u lunas-watcher -f`
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
